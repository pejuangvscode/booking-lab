generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id        String     @id @unique @default(uuid())
  createdAt DateTime   @default(now())
  role      String     @default("user")
  bookings  Bookings[]

  @@map("users")
}

model Lab {
  id         String     @id @unique @default(uuid())
  facilityId String     @unique
  name       String
  type       String
  capacity   Int
  department String
  createdAt  DateTime   @default(now())
  image      String?
  picIds     Json?      // JSON array of PIC user IDs
  roomType   String     @default("student_lab") @map("room_type") // student_lab or staff_room
  bookings   Bookings[]

  @@map("rooms")
}

model Bookings {
  id              Int       @id @default(autoincrement())
  userId          String
  roomId          String
  bookingDate     DateTime
  startTime       String
  endTime         String
  participants    Int
  eventName       String
  eventType       String
  phone           String
  faculty         String
  equipment       String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  requesterNIM    String?
  requesterName   String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  adminNote       String?
  approvedAt      DateTime?
  approvedBy      String?
  room            Lab     @relation(fields: [roomId], references: [id])
  user            Users     @relation(fields: [userId], references: [id])

  @@map("bookings")
}
